{
  "name": "edge-element-tools",
  "version": "0.1.0",
  "private": true,
  "description": "A Microsoft Edge Manifest V3 extension for selecting elements and copying logs.",
  "type": "module",
  "scripts": {
    "check": "npm run validate && npm run review && npm test",
    "validate": "node tools/check-manifest.mjs",
    "review": "node tools/review.mjs",
    "test": "node tools/test.mjs",
    "e2e": "node tools/e2e.mjs",
    "edge:dev": "node tools/edge-dev.mjs",
    "ai:modify": "node tools/ai-modify.mjs",
    "package": "node tools/package.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=18"
  }
}
